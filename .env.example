# Copy to .env.local and fill in. Find these at https://www.sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run the migration (npm run migrate). Create under API → Tokens with "Editor" permissions.
# Keep it secret: never prefix with NEXT_PUBLIC_, never commit it.
SANITY_API_WRITE_TOKEN=
